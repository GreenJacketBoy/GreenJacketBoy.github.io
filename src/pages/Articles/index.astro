---
import ArticlesLayout from "../../components/ArticlesLayout.astro"
import {gP} from "../../utils/posts.js"

const astroFiles = import.meta.glob('./*.astro', {eager:true})
const posts = gP(astroFiles)
---
<ArticlesLayout buttonRedirectsToHome={true}>

<h1> Heyyyyy, this is the articles page ! </h1>

<p> Quite self explanatory, it's a place for me to write articles about what I think and do. I won't treat it as a social media and post anything that I haven't thought through for some time, but you do have to keep in mind that I'm not a philosopher or an essayist. </p>

<h1> Published articles : </h1>

<nav>
{posts.map((post)=> (
  <div class="article">
    <a href={post.link}> 
        <h3>{post.title}</h3>
    </a>
    <p> Published
        <time datetime={post.pubDate}>
            {new Date(post.pubDate)
                 .toLocaleDateString('en-GB',
                                     { day: 'numeric',
                                       month: 'long',
                                       year: 'numeric' })
                 .toLowerCase()}
        </time>
    </p>
  </div>
))}
</nav>

</ArticlesLayout>  
